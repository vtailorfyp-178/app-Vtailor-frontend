# Copy to .env and set your PC Wi‑Fi IPv4 from: ipconfig
# Backend: cd ..\..\app-Vtailor && .\start-api.ps1
# Direct API (needs firewall on port 8000):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:8000/app/api/v1
# Expo Go: PC ka Wi‑Fi IP (ipconfig) — phone same Wi‑Fi par hona chahiye
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.8:8000/app/api/v1
#
# --- 3D models (Cloudinary via Node models-service) ---
# 1) cd ..\..\app-Vtailor\models-service && npm install && npm run upload:glbs && npm start
# 2) Point app at models API (phone: use PC LAN IP + port 3001, or Metro :8081 with proxy)
EXPO_PUBLIC_MODELS_API_URL=https://app-vtailor.onrender.com/app/api/v1
# Web dev (Metro proxies /models → :3001): leave unset to use window.location.origin
EXPO_PUBLIC_USE_CLOUDINARY_MODELS=true
#
# Legacy local fallback (if Cloudinary catalog empty):
#   http://YOUR_PC_IP:8000/3dModels/3d%20model/...
# npm run sync:3dmodels-backend
