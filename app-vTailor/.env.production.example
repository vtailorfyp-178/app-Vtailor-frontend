# Copy to .env before running: eas build -p android --profile preview
# Replace YOUR_PUBLIC_API_HOST with your deployed backend URL (not localhost / PC IP).

# Main API — must be reachable from any phone on mobile data or Wi‑Fi
EXPO_PUBLIC_API_BASE_URL=https://YOUR_PUBLIC_API_HOST/app/api/v1

# 3D models service (optional if Cloudinary catalog is enabled)
EXPO_PUBLIC_MODELS_API_URL=https://YOUR_MODELS_API_HOST

EXPO_PUBLIC_USE_CLOUDINARY_MODELS=true

# Measurement mannequin GLB (works without your models server)
EXPO_PUBLIC_MEASUREMENT_MODEL_URL=https://res.cloudinary.com/db7k22ekb/raw/upload/v1780245604/vtailor-models/measurement-models/measurement-model
