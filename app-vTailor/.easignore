# EAS Build upload — exclude files not needed to compile the app
# Must be committed to git for EAS to read it.
# https://expo.fyi/eas-build-archive

node_modules/
**/.expo-export-test/
**/.expo/
dist/
web-build/
android/
ios/

# Do NOT exclude "dress_assets/" — customize3d.tsx requires those PNGs at build time.

.git/
.vscode/
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Keep secrets local; use eas.json "env" for EXPO_PUBLIC_* on EAS builds
.env
.env.local
.env.*.local

scripts/**/*.glb
**/3d model/
