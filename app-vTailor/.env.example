# Copy to .env and set your PC Wi‑Fi IPv4 from: ipconfig
# Backend: cd ..\..\app-Vtailor && .\start-api.ps1
# Direct API (needs firewall on port 8000):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:8000/app/api/v1
# Expo Go dev: Metro proxies /app/api → :8000 — use your PC IP + Metro port (often 8081), or leave unset.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:8081/app/api/v1
#
# --- 3D models (Cloudinary) ---
# 1) models-service: npm start  (port 3001)
# 2) Web: leave MODELS_API unset — Metro proxies http://localhost:8081/models → :3001
# 3) Phone: EXPO_PUBLIC_MODELS_API_URL=http://YOUR_PC_IP:3001
EXPO_PUBLIC_USE_CLOUDINARY_MODELS=true
# EXPO_PUBLIC_MODELS_API_URL=http://192.168.1.6:3001
#
# Legacy local fallback (if Cloudinary catalog empty):
#   http://YOUR_PC_IP:8000/3dModels/3d%20model/...
# npm run sync:3dmodels-backend
