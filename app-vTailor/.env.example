# Run: npm run env:mobile   (auto-fills your PC Wi-Fi IP)
# Or copy to .env and replace YOUR_PC_IP from ipconfig

# Backend (required for login) — cd ../../Folder && .\start-api.ps1
EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_IP:8000/app/api/v1

# 3D models API (optional; app has bundled catalog if this is down)
EXPO_PUBLIC_MODELS_API_URL=http://YOUR_PC_IP:3001
EXPO_PUBLIC_USE_CLOUDINARY_MODELS=true

# Measurement mannequin GLB (works without backend when set)
EXPO_PUBLIC_MEASUREMENT_MODEL_URL=https://res.cloudinary.com/db7k22ekb/raw/upload/v1780245604/vtailor-models/measurement-models/measurement-model
